# ============================================================================
# AISRM1 — AI-ResearchHub — Example environment file
# Copy to .env for local development. NEVER commit real secrets.
# ============================================================================

# --- App ---
APP_ENV=local
APP_NAME=AISRM1
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEFAULT_LOCALE=vi
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Database (PostgreSQL + pgvector) ---
# In docker-compose the host is "db"; for native local dev use 127.0.0.1
DATABASE_URL=postgresql+psycopg://aisrm1:aisrm1@db:5432/aisrm1
POSTGRES_USER=aisrm1
POSTGRES_PASSWORD=aisrm1
POSTGRES_DB=aisrm1

# --- Auth (local dev uses local auth + JWT; production uses SSO/OIDC) ---
AUTH_PROVIDER=local
AUTH_SECRET=dev-only-change-me-in-production-please-32+chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# OIDC_ISSUER=
# OIDC_AUDIENCE=

# --- Object storage (MinIO local / GCS production) ---
STORAGE_DRIVER=local                 # local | minio | gcs
STORAGE_LOCAL_PATH=./storage_local
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
GCS_BUCKET_DOCUMENTS=aisrm1-documents
GCS_BUCKET_QUARANTINE=aisrm1-quarantine

# --- Async task queue (local thread / Cloud Tasks production) ---
TASK_DRIVER=local                    # local | redis | cloud_tasks
REDIS_URL=redis://redis:6379/0
WORKER_AUDIENCE=

# --- AI / LLM (mock local / Anthropic / Vertex AI) ---
LLM_PROVIDER=mock                    # mock | anthropic | vertex_ai
LLM_MODEL=claude-sonnet-4-6          # model alias resolved per provider
# ANTHROPIC_API_KEY=                 # Secret Manager in production; never log
# VERTEX_PROJECT=
# VERTEX_LOCATION=
EMBEDDING_PROVIDER=mock              # mock | anthropic | vertex_ai
EMBEDDING_MODEL=mock-embed-768
EMBEDDING_DIM=768
AI_MONTHLY_BUDGET=100
AI_ALLOWED_CLASSIFICATIONS=PUBLIC,INTERNAL,CONFIDENTIAL

# --- Email / notifications (optional) ---
EMAIL_PROVIDER=console
# EMAIL_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
